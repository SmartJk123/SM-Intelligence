meta {
  name: Update Preferences
  type: http
  seq: 9
}

put {
  url: {{notificationsBaseUrl}}/api/notifications/preferences?userId=00000000-0000-0000-0000-000000000001
  body: json
  auth: none
}

params:query {
  userId: 00000000-0000-0000-0000-000000000001
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "inAppEnabled": true,
    "emailEnabled": true,
    "smsEnabled": false,
    "pushEnabled": true,
    "deliveryChannels": [
      "IN_APP",
      "PUSH",
      "EMAIL"
    ]
  }
}
