meta {
  name: KCB credential status
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/admin/bank-integrations/kcb/credentials
  body: none
  auth: none
}

docs {
  Reports which credentials the service has loaded, never the values. Only a
  masked tail of the client key is returned.

  tokenReady is the field to watch. When it is false the service cannot obtain
  an access token, and the advice field explains what to do about it.
}

tests {
  test("credential status returns with 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("the flags are reported for KCB", function() {
    const body = res.getBody();
    expect(body.bankId).to.equal("kcb");
    expect(body).to.have.property("clientKeyConfigured");
    expect(body).to.have.property("clientSecretConfigured");
    expect(body).to.have.property("tokenReady");
  });
}