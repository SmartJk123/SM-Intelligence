meta {
  name: NCBA credential status
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/admin/bank-integrations/ncba/credentials
  body: none
  auth: none
}

docs {
  Reports which credentials the service has loaded, never the values. Only a
  masked tail of the secret key and of the username is returned.

  NCBA issues nothing over an API. The secret key, the username and the password
  are the values this service puts on the request letter, so tokenReady here
  means all three are loaded. registrationReady means the callback address is
  public, because NCBA configures the address on their side.
}

tests {
  test("credential status returns with 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("the flags are reported for NCBA", function() {
    const body = res.getBody();
    expect(body.bankId).to.equal("ncba");
    expect(body).to.have.property("clientKeyConfigured");
    expect(body).to.have.property("clientSecretConfigured");
    expect(body).to.have.property("tokenReady");
  });

  test("no secret is returned, only which field the third value is", function() {
    const body = res.getBody();
    expect(body.apiKeySource).to.include("NCBA");
    expect(body.clientKeyHint).to.not.include("NCBA_SECRET_KEY");
  });
}
