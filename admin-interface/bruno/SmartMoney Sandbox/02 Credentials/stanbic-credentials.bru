meta {
  name: Stanbic credential status
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/admin/bank-integrations/stanbic/credentials
  body: none
  auth: none
}

docs {
  Reports which credentials the service has loaded, never the values.

  apiKeySource tells you where the ApiKey field of a registration request came
  from. It reads "client key fallback" when no separate ApiKey has been issued.
}

tests {
  test("credential status returns with 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("the flags are reported for Stanbic", function() {
    const body = res.getBody();
    expect(body.bankId).to.equal("stanbic");
    expect(body).to.have.property("tokenReady");
    expect(body).to.have.property("registrationReady");
  });
}