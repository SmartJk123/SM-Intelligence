# Copy this file to .env in the same folder and fill it in.
# .env is git ignored and is never committed.
#
# The service has no authentication while PERMIT_ALL is true, so none of these
# values are needed yet. They are here for when it is switched on.
#
# The Bruno CLI loads .env from the collection root, masks the values in its
# output, and interpolates them as {{process.env.SM_ADMIN_USER}}.

SM_ADMIN_USER=
SM_ADMIN_PASSWORD=