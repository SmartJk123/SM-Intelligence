meta {
  name: NCBA notification URL
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/api/v1/admin/bank-integrations/ncba/webhook-url
  body: none
  auth: none
}

docs {
  The address to put on the NCBA request letter.

  publiclyReachable is false while the address is localhost or its hostname no
  longer resolves. NCBA configures this address on their side, so a tunnel that
  is issued a new hostname on every start is not suitable for anything beyond a
  short test.

  accountNumber is null until NCBA_ACCOUNT_NUMBER is set.
}

tests {
  test("notification URL returns with 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("the address points at the NCBA endpoint", function() {
    const body = res.getBody();
    expect(body.webhookUrl).to.include("/api/v1/webhooks/ncba");
    expect(body).to.have.property("publiclyReachable");
  });
}
