# ============================================================
# SM-INTELLIGENCE ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================
# INSTRUCTIONS:
# 1. Copy this file to .env in your local environment:
#      cp .env.example .env
# 2. Update the values below to match your local or server setup.
# 3. NEVER commit .env to version control (.gitignore already ignores it).
# ============================================================

# ------------------------------------------------------------
# 1. Global Database Credentials (PostgreSQL)
# ------------------------------------------------------------
DB_USER=admin
DB_PASSWORD=secretpassword

# ------------------------------------------------------------
# 2. Microservice Database Ports (Host Mappings)
# ------------------------------------------------------------
DB_PORT_IDENTITY=5432
DB_PORT_ACCOUNTS=5433
DB_PORT_TRANSACTIONS=5434
DB_PORT_CATEGORIES=5435
DB_PORT_BUDGETS=5436
DB_PORT_INVESTMENTS=5437
DB_PORT_FORECASTS=5438
DB_PORT_NOTIFICATIONS=5439
DB_PORT_AUDIT=5440

# ------------------------------------------------------------
# 3. Service HTTP Ports
# ------------------------------------------------------------
PORT_API_GATEWAY=8080
PORT_IDENTITY_SERVICE=8081
PORT_ACCOUNTS_SERVICE=8082
PORT_TRANSACTIONS_SERVICE=8083
PORT_CATEGORIES_SERVICE=8084
PORT_BUDGETS_SERVICE=8085
PORT_INVESTMENTS_SERVICE=8086
PORT_FORECASTS_SERVICE=8087
PORT_NOTIFICATIONS_SERVICE=8088
PORT_AUDIT_SERVICE=8089

# ------------------------------------------------------------
# 4. Message Broker (Apache Kafka - KRaft Mode)
# ------------------------------------------------------------
KAFKA_BROKER_PORT=9092

# ------------------------------------------------------------
# 5. Security & Authentication (JWT)
# ------------------------------------------------------------
# IMPORTANT: In production, generate a secure 256-bit secret using:
# openssl rand -hex 32
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------
# 6. Regional & Localization Defaults (Kenya)
# ------------------------------------------------------------
DEFAULT_CURRENCY=KES
DEFAULT_TIMEZONE=Africa/Nairobi
