# api-gateway settings. Nothing here is secret; the defaults suit a local run.

# Browser origins allowed to call the gateway: the web app and the admin portal.
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4300

IDENTITY_SERVICE_URL=http://localhost:8081
ACCOUNTS_SERVICE_URL=http://localhost:8082
TRANSACTIONS_SERVICE_URL=http://localhost:8083
BANK_INTEGRATION_SERVICE_URL=http://localhost:8090
