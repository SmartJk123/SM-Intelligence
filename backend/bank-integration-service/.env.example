# Bank integration service configuration.
#
# Copy this file to .env.local and fill it in. .env.local is ignored by git, so
# it never leaves the machine it was written on: it does not appear in git
# status, it does not travel when you switch branches, and a teammate who clones
# the repository does not get it. The committed template is this file.
#
# run-local.ps1 loads .env.local into the environment and strips DEBUG, which
# otherwise switches Spring into full debug logging and buries the useful lines.
#
# Mark every value that is really secret as sync: false in render.yaml when the
# service is deployed, so the host reads it from its own dashboard.

# ------------------------------------------------------------------ shared
# The public HTTPS address a bank can reach. A bank cannot reach localhost, so
# until a tunnel or a deployment sets this, only this machine can deliver.
PUBLIC_BASE_URL=

# true while developing, which leaves the admin endpoints unauthenticated.
PERMIT_ALL=true

# -------------------------------------------------------------------- NCBA
# All three are generated here and sent to NCBA in writing. The secret key must
# be 16 characters or more and must not change after NCBA has it, because every
# HashVal in every notification is computed from it.
NCBA_SECRET_KEY=
NCBA_USERNAME=
NCBA_PASSWORD=
NCBA_ACCOUNT_NUMBER=1004906164
NCBA_ENV=SANDBOX
NCBA_SIGNATURE_VERIFICATION=true

# --------------------------------------------------------------------- KCB
KCB_CLIENT_KEY=
KCB_CLIENT_SECRET=
# A PEM block, a path to a .pem file, or a base64 X.509 key.
KCB_PUBLIC_KEY=
KCB_ENV=SANDBOX
KCB_SIGNATURE_VERIFICATION=true
# Optional. Only set it when the portal names a token host other than
# https://accounts.buni.kcbgroup.com/oauth2/token
KCB_TOKEN_URL=
KCB_ACCESS_TOKEN=eyJ4NXQiOiJRYzBpWl95cWV1bHdkbEVxbjB6UTBWbnlTaW8iLCJraWQiOiJOV1ptWm1Ga01qTTROVEV5TmpJMVpETm1aV1prTjJSaVpXSmlabVl5TXpVM016YzBNVE15Tm1RMU9EaGpPREJrT1dGa09URXlOVEZpWWpneFpXUXdNQV9SUzI1NiIsInR5cCI6ImF0K2p3dCIsImFsZyI6IlJTMjU2In0..b46B33f-3ci4zyOx8dTLuNVdU2TyUBc9k1Lnn_mgvXwkbcrYHhFaL3Gt7JyQzUuziT4MYfO1vbI7JBxlfYcOyxLjTSWIQnH_8SPsw2i7qXZwidjSY8nUrRrQtGnw6c0SYIqcK65kVm7bqizLmQa7A48CGNHs-H_s-xCyhaJcNTAebPnQ6Mro4HlWOhnP_0fjrFwzN-4a4IJDb8nmxjQTAC46riz7rhj6c6Ak4aNvVAHOh9917Sg-JlchIPD7bMNNnLqorW7X3JVeNC6mEtKsD4UDRFizh_MWUfUSe85tXU0IpRi9a7Z2ifyaBFxl52_DRRFu7AkyKFhGZZ9rw0zO3A
# ----------------------------------------------------------------- Stanbic
STANBIC_CLIENT_KEY=
STANBIC_CLIENT_SECRET=
# The ApiKey field of a registration request. Falls back to the client key.
STANBIC_API_KEY=
STANBIC_ACCOUNT_NUMBER=0100013306316
STANBIC_ENV=SANDBOX
STANBIC_SIGNATURE_VERIFICATION=true
# Copy the exact value from the API product page. The specification default
# returns HTTP 404, so this is usually the one value that blocks Stanbic.
# STANBIC_TOKEN_URL=

# ---------------------------------------------------------------- database
# Only used with the postgres profile. Locally the service writes an H2 file
# under data/, which git ignores.
# DB_URL=
# DB_HOST=
# DB_PORT=
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
