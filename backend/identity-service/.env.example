# Database (Postgres)
DB_URL=jdbc:postgresql://localhost:5432/smi_identity
DB_USER=admin
DB_PASSWORD=secretpassword

# JWT signing key. Must be set — there is no default. Use a long random string.
JWT_SECRET=

# Comma-separated platform administrator addresses. Each gets the PLATFORM_ADMIN
# role (admin interface access) at start up or when it registers.
ADMIN_EMAILS=

# Comma-separated list of origins allowed to call this service (CORS).
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200

# Outbound email (organization invites / credentials). Leave MAIL_HOST blank in
# local dev to skip sending — org/member creation still succeeds, with
# emailSent=false in the API response. Point at a local catcher such as
# Mailpit (MAIL_HOST=localhost, MAIL_PORT=1025, MAIL_SMTP_AUTH=false) to see
# the emails without a real SMTP provider.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM=no-reply@smartmoney.io

# Where the login link in invite emails points: the customer web app sign in.
# Invited members are customers, and the admin login refuses non-admin accounts.
FRONTEND_LOGIN_URL=http://localhost:4200/login
