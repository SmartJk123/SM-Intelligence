# identity-service settings. Copy to .env.local (ignored by git) and fill in.
# Or run backend/new-local-env.ps1, which creates every service's .env.local
# with matching shared secrets.

# Database (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/smi_identity
DB_USER=admin
DB_PASSWORD=secretpassword

# Signs every sign-in token. At least 32 characters, no default.
# MUST be the same value as JWT_SECRET in bank-integration-service/.env.local.
JWT_SECRET=

# Comma-separated addresses that get the PLATFORM_ADMIN role (admin portal access).
ADMIN_EMAILS=

# Outgoing email: password reset links and organisation invitations.
# Leave SMTP_HOST empty to send nothing (the service still works).
# Port 587 uses STARTTLS, port 465 uses TLS. For Gmail use an app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=

# Pages named in emails.
PASSWORD_RESET_URL=http://localhost:4200/reset-password
FRONTEND_LOGIN_URL=http://localhost:4200/login

# Health alerts: every minute identity-service checks the other services and emails
# ADMIN_EMAILS (or HEALTH_ALERT_EMAILS, if set) when one is down or degraded, every
# hour while it lasts, and when it recovers. Uses the SMTP settings above.
# HEALTH_ALERT_EMAILS=
# HEALTH_MONITOR_ENABLED=true
