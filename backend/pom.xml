<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.smi</groupId>
    <artifactId>smi-backend-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>SM-Intelligence Backend</name>
    <description>Parent POM for SM-Intelligence microservices</description>

    <properties>
        <!-- The compiler release for every module.

             It was 25, so the whole reactor needed a JDK 25 toolchain before
             anything built and every module reported "release 25 is not found in
             the system" on a machine with JDK 21. The code does not need it:
             compiled against release 21 the reactor succeeds, because every
             dependency on the classpath, Spring Boot 4.1.1 included, carries Java
             21 bytecode or older.

             Override with -Djava.release=25 where a JDK 25 toolchain exists. -->
        <java.release>21</java.release>
        <java.version>${java.release}</java.version>

        <!-- Mockito reaches the test JVM through the JDK attach API. Without this
             every mocked test fails with "Could not self-attach to current VM
             using external process", wrapped in "Could not initialize inline
             Byte Buddy mock maker". Override with -Dsurefire.argLine=... rather
             than editing this line, so a coverage agent can never be silently
             dropped. -->
        <surefire.argLine>-Djdk.attach.allowAttachSelf=true -XX:+EnableDynamicAgentLoading</surefire.argLine>
        <spring-cloud.version>2025.1.3</spring-cloud.version>
    </properties>

    <modules>
        <module>api-gateway</module>
        <module>identity-service</module>
        <module>accounts-service</module>
        <module>transactions-service</module>
        <module>categories-service</module>
        <module>budgets-service</module>
        <module>investments-service</module>
        <module>forecasts-service</module>
        <module>notifications-service</module>
        <module>audit-service</module>
        <module>bank-integration-service</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>${surefire.argLine}</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
