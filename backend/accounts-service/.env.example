# accounts-service settings. Copy to .env.local (ignored by git) and fill in,
# or run backend/new-local-env.ps1.

# Database. On a single local PostgreSQL every database is on 5432; with
# backend/docker-compose.yml accounts is on 5433.
DB_URL=jdbc:postgresql://localhost:5432/smi_accounts
DB_USER=admin
DB_PASSWORD=secretpassword

# Lets bank-integration-service create a customer's linked account and move its
# balance when a payment lands. MUST be the same value as INTERNAL_SERVICE_TOKEN
# in bank-integration-service/.env.local, or balances never move.
INTERNAL_SERVICE_TOKEN=

IDENTITY_SERVICE_URL=http://localhost:8081
