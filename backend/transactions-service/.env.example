# transactions-service settings. Copy to .env.local (ignored by git) and fill in,
# or run backend/new-local-env.ps1.

# Database. On a single local PostgreSQL every database is on 5432; with
# backend/docker-compose.yml transactions is on 5434.
DB_URL=jdbc:postgresql://localhost:5432/smi_transactions
DB_USER=admin
DB_PASSWORD=secretpassword

# Used to check the signed-in user and read their accounts (activity feed, invoices).
IDENTITY_SERVICE_URL=http://localhost:8081
ACCOUNTS_SERVICE_URL=http://localhost:8082
