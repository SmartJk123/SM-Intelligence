# The Docker build context is this folder, so this list keeps things out of the
# image. Without it a COPY would bake the bank credentials, the rehearsal keys
# and the local databases into it.
**/.env
**/.env.*
!.env.example
**/keys/
**/data/
**/target/
**/*.mv.db
**/*.log
**/hs_err_pid*.log
**/replay_pid*.log
**/.tunnel-config.yml
