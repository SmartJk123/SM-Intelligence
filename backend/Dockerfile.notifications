# syntax=docker/dockerfile:1

# Stage 1: Build notifications-service
FROM maven:3.9-eclipse-temurin-25 AS builder
WORKDIR /workspace

# Copy parent POM and all module POMs for dependency caching
COPY pom.xml .
COPY api-gateway/pom.xml api-gateway/
COPY identity-service/pom.xml identity-service/
COPY accounts-service/pom.xml accounts-service/
COPY transactions-service/pom.xml transactions-service/
COPY categories-service/pom.xml categories-service/
COPY budgets-service/pom.xml budgets-service/
COPY investments-service/pom.xml investments-service/
COPY forecasts-service/pom.xml forecasts-service/
COPY notifications-service/pom.xml notifications-service/
COPY audit-service/pom.xml audit-service/
COPY bank-integration-service/pom.xml bank-integration-service/
COPY assistant-service/pom.xml assistant-service/

# Cache Maven dependencies
RUN mvn dependency:go-offline -B || true

# Copy the full source trees
COPY . .

# Build notifications-service explicitly
RUN mvn clean package -pl notifications-service -am -DskipTests

# Stage 2: Production JRE image
FROM eclipse-temurin:25-jre
WORKDIR /app

RUN mkdir -p /app/data && chown -R 1001:1001 /app

COPY --from=builder --chown=1001:1001 /workspace/notifications-service/target/*.jar app.jar

# Run as non-root user
USER 1001:1001

ENTRYPOINT ["java", \
  "-Xms128m", \
  "-Xmx256m", \
  "-Xss256k", \
  "-XX:MaxMetaspaceSize=128m", \
  "-XX:TieredStopAtLevel=1", \
  "-Djava.security.egd=file:/dev/./urandom", \
  "-jar", "app.jar"]
