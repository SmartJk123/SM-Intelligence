# budgets-service settings. Copy to .env.local (ignored by git) and fill in,
# or run backend/new-local-env.ps1.

# Database. Budgets keeps its own "budgets" schema inside smi_transactions, so a
# local PostgreSQL needs no extra database (the schema is created on first start).
# With backend/docker-compose.yml use its smi_budgets database on 5436 instead.
DB_URL=jdbc:postgresql://localhost:5432/smi_transactions?currentSchema=budgets
DB_SCHEMA=budgets
DB_USER=admin
DB_PASSWORD=secretpassword
