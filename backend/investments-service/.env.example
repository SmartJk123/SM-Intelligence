# investments-service settings. Copy to .env.local (ignored by git) and fill in,
# or run backend/new-local-env.ps1.

# Database. Investments keeps its own "investments" schema inside smi_transactions, so a
# local PostgreSQL needs no extra database (the schema is created on first start).
# With backend/docker-compose.yml use its smi_investments database on 5437 instead.
DB_URL=jdbc:postgresql://localhost:5432/smi_transactions?currentSchema=investments
DB_SCHEMA=investments
DB_USER=admin
DB_PASSWORD=secretpassword
